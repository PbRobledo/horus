	measure 'China Precio Sem Ant' =
			VAR _sem = CALCULATE ( MAX ( Calendario[Semana índice] ), 'HAC Tabla_China' )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [China Precio Final], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem - 1 )
			    )
		formatString: \$ #,0.00
		displayFolder: China\Precio
		lineageTag: bd4320bf-8606-4bc2-9ca0-c773e1c782b2

	measure 'China Var % Sem Ant' =
			VAR _ant = [China Precio Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [China Precio Ult Sem] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: China\Precio
		lineageTag: 1b97789a-2048-4241-9ed6-6c6e80b2c94c

	measure 'China Precio 4 Sem Móvil' =
			VAR _sem = CALCULATE ( MAX ( Calendario[Semana índice] ), 'HAC Tabla_China' )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE (
			            [China Precio Final],
			            REMOVEFILTERS ( Calendario ),
			            Calendario[Semana índice] > _sem - 4,
			            Calendario[Semana índice] <= _sem
			        )
			    )
		formatString: \$ #,0.00
		displayFolder: China\Precio
		lineageTag: 5535e2dd-a10a-4cb6-8dec-e98fbd472af8

