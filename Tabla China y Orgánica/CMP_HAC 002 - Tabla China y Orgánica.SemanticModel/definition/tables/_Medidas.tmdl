	measure 'China Cab por calidad' =
			VAR _cab =
			    SUMX (
			        VALUES ( Calidades[Calidad] ),
			        SWITCH (
			            Calidades[Calidad],
			            "A", [China Cab A],
			            "B", [China Cab B],
			            "C", [China Cab C],
			            "D", [China Cab D],
			            "E", [China Cab E],
			            "Decomiso", [China Cab Decomiso]
			        )
			    )
			RETURN
			    IF ( _cab <> 0, _cab )
		formatString: #,0.#
		displayFolder: China\Faena
		lineageTag: 32827560-e3ee-48ec-b21e-6ed056c58fe7

