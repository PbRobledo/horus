	measure 'Ultima carga ETL' =
			VAR _f =
			    CALCULATE (
			        MAX ( MAX ( 'HAC Tabla_China'[fecha_actualizacion] ), MAX ( 'HAC Tabla_Organico'[fecha_actualizacion] ) ),
			        REMOVEFILTERS ()
			    )
			RETURN
			    "Datos al " & FORMAT ( _f, "dd/mm/yyyy hh:nn" )
		displayFolder: General
