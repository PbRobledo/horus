	measure 'China Desvío vs Total' =
			VAR _precio = [China Precio Final]
			RETURN
			    IF (
			        NOT ISBLANK ( _precio ),
			        _precio - CALCULATE ( [China Precio Final], REMOVEFILTERS ( Tropas[Comprador], Tropas[Proveedor], Tropas[tropa] ) )
