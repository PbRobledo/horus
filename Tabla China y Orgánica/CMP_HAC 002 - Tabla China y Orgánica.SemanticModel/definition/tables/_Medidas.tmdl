	measure 'Semana reportada' =
			VAR _sem =
			    MAX (
			        CALCULATE ( MAX ( Calendario[Semana índice] ), 'HAC Tabla_China' ),
			        CALCULATE ( MAX ( Calendario[Semana índice] ), 'HAC Tabla_Organico' )
			    )
			VAR _ini = CALCULATE ( MIN ( Calendario[Date] ), REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			VAR _nombre = CALCULATE ( MAX ( Calendario[Semana] ), REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        "Semana " & _nombre & " · faena del " & FORMAT ( _ini, "dd/mm" ) & " al " & FORMAT ( _ini + 6, "dd/mm/yyyy" )
			    )
		displayFolder: General
		lineageTag: 910705d8-e4bf-445c-b51c-7544a5aa5913

	measure 'China Tropas sin costear' = COUNTROWS ( FILTER ( 'HAC Tabla_China', NOT COALESCE ( 'HAC Tabla_China'[tropa_liquidada], FALSE () ) ) )
		formatString: #,0
		displayFolder: China\Costeo
		lineageTag: 8c11c339-8bc7-4a12-a772-23e3c0f25e86

	measure 'China Aviso costeo' =
			VAR _sin = FILTER ( 'HAC Tabla_China', NOT COALESCE ( 'HAC Tabla_China'[tropa_liquidada], FALSE () ) )
			VAR _n = COUNTROWS ( _sin )
			VAR _lista =
			    CONCATENATEX (
			        TOPN ( 3, _sin, 'HAC Tabla_China'[fecha_faena], ASC, 'HAC Tabla_China'[tropa], ASC ),
			        'HAC Tabla_China'[tropa] & " (" & 'HAC Tabla_China'[proveedor] & ", faena " & FORMAT ( 'HAC Tabla_China'[fecha_faena], "dd/mm" ) & ")",
			        " · ",
			        'HAC Tabla_China'[fecha_faena], ASC, 'HAC Tabla_China'[tropa], ASC
			    )
			RETURN
			    IF (
			        ISBLANK ( _n ),
			        IF ( NOT ISEMPTY ( 'HAC Tabla_China' ), "Todas las tropas de la selección están costeadas en SAP." ),
			        "⚠ " & _n & IF ( _n = 1, " tropa sin costear en SAP", " tropas sin costear en SAP" )
			            & " (sin monto ni precio hasta que se liquide): " & _lista
			            & IF ( _n > 3, " · y " & ( _n - 3 ) & " más" )
			    )
		displayFolder: China\Costeo
		lineageTag: 101c0182-5ff1-4dbc-9534-ef515bfa0da9

	measure 'China Aviso costeo color' = IF ( [China Tropas sin costear] > 0, "#b3261e", "#1e6b3a" )
		displayFolder: China\Costeo
