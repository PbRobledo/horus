	column 'Semana índice'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a3df2e03-dd22-4a75-bf5b-66477d77e17f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana índice]

		annotation SummarizationSetBy = Automatic

	column 'Semana filtro' =
			-- la última semana con faena en cualquiera de los programas se muestra como "Semana actual"
			VAR _max = MAX ( MAX ( 'HAC Tabla_China'[fecha_faena] ), MAX ( 'HAC Tabla_Organico'[fecha_faena] ) )
			VAR _ult = INT ( ( _max - WEEKDAY ( _max, 3 ) - DATE ( 2024, 12, 30 ) ) / 7 )
			RETURN
			    IF ( Calendario[Semana índice] = _ult, "Semana actual", Calendario[Semana] )
		dataType: string
		lineageTag: 723ced15-c9f7-42e7-9e5f-dfceccba0787
		summarizeBy: none
		sortByColumn: 'Semana índice'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				-- Calendario único: cubre de lunes a domingo las semanas con faena en ambas tablas.
				-- Semana = semana ISO del lunes de la fecha de faena (misma regla que semana_inicio del ETL).
				VAR _min = MIN ( MIN ( 'HAC Tabla_China'[fecha_faena] ), MIN ( 'HAC Tabla_Organico'[fecha_faena] ) )
				VAR _max = MAX ( MAX ( 'HAC Tabla_China'[fecha_faena] ), MAX ( 'HAC Tabla_Organico'[fecha_faena] ) )
				VAR _ini = _min - WEEKDAY ( _min, 3 )
				VAR _fin = _max - WEEKDAY ( _max, 3 ) + 6
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _ini, _fin ),
				        "Semana inicio", [Date] - WEEKDAY ( [Date], 3 ),
				        "Año", YEAR ( [Date] - WEEKDAY ( [Date], 3 ) ),
				        "Mes Nro", MONTH ( [Date] - WEEKDAY ( [Date], 3 ) ),
				        "Mes", FORMAT ( [Date] - WEEKDAY ( [Date], 3 ), "mmmm" ),
				        "Año ISO", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				        "Semana ISO", WEEKNUM ( [Date], 21 ),
				        "Semana", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ) & "-S" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				        "Semana índice", INT ( ( [Date] - WEEKDAY ( [Date], 3 ) - DATE ( 2024, 12, 30 ) ) / 7 )
				    )

	annotation PBI_Id = 36a8c664c408484c8df4454f2dbff3ef

