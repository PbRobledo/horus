	measure 'PI Pares sin nacional' = COUNTROWS ( SUMMARIZE ( FILTER ( 'PRC Price_Index', ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[EAN_Numerador], 'PRC Price_Index'[EAN_Denominador] ) )
		formatString: #,0
		displayFolder: Price Index\Calidad de datos
		lineageTag: 22609b9f-f540-5471-b548-0952b7918665

	measure 'PI Aviso' =
			VAR _n = [PI Pares sin nacional]
			RETURN
			    IF (
			        ISEMPTY ( 'PRC Price_Index' ),
			        "Sin datos de Price Index para la selección.",
			        "Nivel de cliente: " & [Texto nivel] & " · "
			            & IF (
			                _n > 0,
			                "⚠ " & _n & IF ( _n = 1, " par", " pares" ) & " sin Price Index Nacional (falta el precio deflactado).",
			                "Todos los pares de la selección tienen Price Index Nacional."
			            )
			    )
		displayFolder: Price Index\Calidad de datos
		lineageTag: 22e2bdae-240a-5a0e-9b39-b0fc481d0a52

	measure 'PI Aviso color' = IF ( [PI Pares sin nacional] > 0, "#b3261e", "#1e6b3a" )
		displayFolder: Price Index\Calidad de datos
		lineageTag: 64cfe60f-0195-5384-8bf0-a5ec5c3975b1

	/// La tabla platinum_4ejes no guarda la fecha de corrida del ETL: se informa la última semana relevada.
	measure 'Ultima semana cargada' =
			VAR _f = CALCULATE ( MAX ( MAX ( 'PRC Precio_Simple'[Fecha] ), MAX ( 'PRC Price_Index'[Fecha] ) ), REMOVEFILTERS () )
			VAR _sem = CALCULATE ( MAX ( Calendario[Semana] ), REMOVEFILTERS (), Calendario[Date] = _f )
			RETURN
			    "Datos hasta " & _sem & " (" & FORMAT ( _f, "dd/mm/yyyy" ) & ")"
		displayFolder: General
		lineageTag: d78f0f38-f0ca-5c72-88d8-290872a4fd39

	/// Semana que muestran las tarjetas de última semana. Si los dos bloques no llegan a la misma semana, informa las dos.
	measure 'Semana reportada' =
			VAR _ps = [PS Semana índice Ult]
			VAR _pi = [PI Semana índice Ult]
			VAR _nps = CALCULATE ( MAX ( Calendario[Semana] ), REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _ps )
			VAR _npi = CALCULATE ( MAX ( Calendario[Semana] ), REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _pi )
			VAR _ini = CALCULATE ( MIN ( Calendario[Date] ), REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _ps )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _ps ) && ISBLANK ( _pi ), BLANK (),
			        ISBLANK ( _pi ), "Precio Simple: semana " & _nps & " · Price Index: sin datos",
			        ISBLANK ( _ps ), "Precio Simple: sin datos · Price Index: semana " & _npi,
			        _ps = _pi, "Semana " & _nps & " · relevamiento del " & FORMAT ( _ini, "dd/mm" ) & " al " & FORMAT ( _ini + 6, "dd/mm/yyyy" ),
			        "Precio Simple: semana " & _nps & " · Price Index: semana " & _npi
			    )
		displayFolder: General
		lineageTag: a0a256cc-890f-5661-910f-f63c652f5df9

	measure 'Texto semana' =
			VAR _n = COUNTROWS ( VALUES ( Calendario[Semana filtro] ) )
			VAR _sel = SELECTEDVALUE ( Calendario[Semana filtro] )
			VAR _actual = CALCULATE ( MAX ( Calendario[Semana] ), REMOVEFILTERS ( Calendario ), Calendario[Semana filtro] = "Semana actual" )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( Calendario[Semana filtro] ), "Todas las semanas",
			        _sel = "Semana actual", "Semana actual (" & _actual & ")",
			        _n = 1, "Semana " & _sel,
			        _n & " semanas (" & MIN ( Calendario[Semana] ) & " a " & MAX ( Calendario[Semana] ) & ")"
			    )
		displayFolder: General\Títulos
		lineageTag: c3d048c6-ed6f-5d16-b701-56af374674e0

	measure 'Texto subcanal' =
			IF (
			    ISFILTERED ( Clientes[Subcanal] ),
			    CONCATENATEX ( VALUES ( Clientes[Subcanal] ), Clientes[Subcanal], " + ", Clientes[Subcanal], ASC ),
			    "Todos los subcanales"
			)
		displayFolder: General\Títulos
		lineageTag: ae788a07-c484-581e-b7f2-49d365f5afe3

	measure 'Texto provincia' =
			VAR _n = COUNTROWS ( VALUES ( Regiones[Provincia] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISFILTERED ( Regiones[Provincia] ), "Todas las provincias",
			        _n > 3, _n & " provincias",
			        CONCATENATEX ( VALUES ( Regiones[Provincia] ), Regiones[Provincia], " + ", Regiones[Provincia], ASC )
			    )
		displayFolder: General\Títulos
		lineageTag: defaddd8-7731-52b3-862a-88eec23b1e39

	measure 'Texto nivel' = IF ( SELECTEDVALUE ( Clientes[Nivel cliente] ) = "Cliente", "Cliente / cadena (panel SNP)", "Subcanal (panel COPI)" )
