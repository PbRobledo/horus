table _Medidas
	lineageTag: c1b6bb28-49ec-5c84-b62c-e62190fb5086

	/// Cantidad de precios relevados (registros de Gold_Comparativo). Aditiva en los 4 ejes.
	measure 'PS Registros' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUM ( 'PRC Precio_Simple'[Cantidad_Registros] ),
			    CALCULATE ( SUM ( 'PRC Precio_Simple'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Precio Simple\Base
		lineageTag: 5665071b-a365-5b27-a10a-9eb68d5e3b1d

	measure 'PS Suma Precio' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( 'PRC Precio_Simple', 'PRC Precio_Simple'[Precio_Promedio] * 'PRC Precio_Simple'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( 'PRC Precio_Simple', 'PRC Precio_Simple'[Precio_Promedio] * 'PRC Precio_Simple'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: \$ #,0
		displayFolder: Precio Simple\Base
		lineageTag: 3e18fc94-b7b4-5ceb-8c4d-e6d3a756e8ed

	measure 'PS Suma Mediana' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( 'PRC Precio_Simple', 'PRC Precio_Simple'[Precio_Mediana] * 'PRC Precio_Simple'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( 'PRC Precio_Simple', 'PRC Precio_Simple'[Precio_Mediana] * 'PRC Precio_Simple'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: \$ #,0
		displayFolder: Precio Simple\Base
		lineageTag: 061ccc7b-c58e-5dd1-92f5-d7fc342513f0

	/// Promedio de Precio_BASE ponderado por registros: reconstruye el promedio exacto del detalle en cualquier nivel de agregación.
	measure 'PS Precio Promedio' = DIVIDE ( [PS Suma Precio], [PS Registros] )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Base
		lineageTag: bf9b8c0e-e16f-51cb-b68b-2deb72e5f1b7

	/// Mediana del ETL ponderada por registros. Exacta al grano de la tabla (SKU x semana x provincia x cliente); por encima de ese grano es una aproximación: una mediana no se puede reagregar.
	measure 'PS Precio Mediana' = DIVIDE ( [PS Suma Mediana], [PS Registros] )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Base
		lineageTag: 1e0d7e64-40d6-550c-bee3-4dcb67cd3a81

	measure 'PS SKUs' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    DISTINCTCOUNT ( 'PRC Precio_Simple'[Cod_SKU] ),
			    CALCULATE ( DISTINCTCOUNT ( 'PRC Precio_Simple'[Cod_SKU] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Precio Simple\Base
		lineageTag: 7d1e53ce-fb38-575a-9ba6-8dce7b2021d7

	measure 'PS Provincias' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    DISTINCTCOUNT ( 'PRC Precio_Simple'[Provincia] ),
			    CALCULATE ( DISTINCTCOUNT ( 'PRC Precio_Simple'[Provincia] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Precio Simple\Base
		lineageTag: 573be008-099d-5da2-90c2-d6e7bce5c8b6

	/// PDV distintos al grano de la tabla. Por encima de ese grano es una suma: un mismo PDV se cuenta una vez por cada SKU y semana.
	measure 'PS PDV' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUM ( 'PRC Precio_Simple'[Cantidad_PDV] ),
			    CALCULATE ( SUM ( 'PRC Precio_Simple'[Cantidad_PDV] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Precio Simple\Base
		lineageTag: 31397cd4-3a32-504a-9fa3-32d2be138234

	measure 'PS Semana índice Ult' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    CALCULATE ( MAX ( Calendario[Semana índice] ), 'PRC Precio_Simple' ),
			    CALCULATE ( CALCULATE ( MAX ( Calendario[Semana índice] ), 'PRC Precio_Simple' ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: 0
		displayFolder: Precio Simple\Base
		lineageTag: 5406f5d9-0411-5de1-8fdc-2d6db6a1368c

	measure 'PS Precio Ult Sem' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS Precio Promedio], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Precio
		lineageTag: 1c2c2214-efc2-5237-b10a-9a33e3752d63

	measure 'PS Precio Sem Ant' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS Precio Promedio], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem - 1 )
			    )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Precio
		lineageTag: 3a0a671d-83fa-5f47-ad44-c33976922473

	measure 'PS Var % Sem Ant' =
			VAR _ant = [PS Precio Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [PS Precio Ult Sem] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Precio Simple\Precio
		lineageTag: 04c14ae2-07fe-523f-bdbb-502228204c30

	measure 'PS Precio 4 Sem Móvil' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE (
			            [PS Precio Promedio],
			            REMOVEFILTERS ( Calendario ),
			            Calendario[Semana índice] > _sem - 4,
			            Calendario[Semana índice] <= _sem
			        )
			    )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Precio
		lineageTag: a618db54-b751-518e-8689-234d38e4f5f8

	/// Precio promedio de la fila menos el precio promedio de toda la selección de los segmentadores.
	measure 'PS Desvío vs Total' =
			VAR _valor = [PS Precio Promedio]
			RETURN
			    IF (
			        NOT ISBLANK ( _valor ),
			        _valor - CALCULATE ( [PS Precio Promedio], ALLSELECTED ( Regiones ), ALLSELECTED ( Clientes ) )
			    )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Precio
		lineageTag: 08f1fca5-465b-5f9a-b1c5-25ac88998a98

	measure 'PS Mediana Ult Sem' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS Precio Mediana], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: \$ #,0.00
		displayFolder: Precio Simple\Última semana
		lineageTag: 5e70c0c0-a84f-54b5-866e-356893c3ec30

	measure 'PS SKUs Ult Sem' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS SKUs], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: #,0
		displayFolder: Precio Simple\Última semana
		lineageTag: a7e56ea9-b417-588d-aba0-f777e0d5fa88

	measure 'PS Provincias Ult Sem' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS Provincias], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: #,0
		displayFolder: Precio Simple\Última semana
		lineageTag: d0c366ac-672d-5e3b-abbb-3a5c2e543454

	measure 'PS Registros Ult Sem' =
			VAR _sem = [PS Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PS Registros], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: #,0
		displayFolder: Precio Simple\Última semana
		lineageTag: 6ad3d31a-3254-5055-b037-1d9feaf5b7c1

	measure 'PS Filas placeholder' = COUNTROWS ( FILTER ( 'PRC Precio_Simple', 'PRC Precio_Simple'[Region_v2_Placeholder] ) )
		formatString: #,0
		displayFolder: Precio Simple\Calidad de datos
		lineageTag: 81102c32-8c41-511d-b462-4fc51d46f679

	measure 'PS Aviso' =
			VAR _n = [PS Filas placeholder]
			RETURN
			    IF (
			        ISEMPTY ( 'PRC Precio_Simple' ),
			        "Sin datos de Precio Simple para la selección.",
			        "Nivel de cliente: " & [Texto nivel] & " · "
			            & IF (
			                _n > 0,
			                "⚠ Región v2 todavía es un placeholder (= Provincia) en " & FORMAT ( _n, "#,0" ) & " filas.",
			                "Región v2 definida en el maestro."
			            )
			    )
		displayFolder: Precio Simple\Calidad de datos
		lineageTag: a9a02ac0-7b6d-5cd9-b4bf-5d5737dc1138

	measure 'PS Aviso color' = IF ( [PS Filas placeholder] > 0, "#9a6700", "#1e6b3a" )
		displayFolder: Precio Simple\Calidad de datos
		lineageTag: 1ae17acc-2d9f-5a1b-8d58-1824c60c6d4d

	/// Cantidad de cocientes numerador / denominador calculados en un mismo PDV. Aditiva en los 4 ejes.
	measure 'PI Cruces PDV' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUM ( 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUM ( 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: 23bdaae0-32e6-550b-9f41-e873f8270d90

	measure 'PI Suma Index' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) ), 'PRC Price_Index'[Price_Index] * 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) ), 'PRC Price_Index'[Price_Index] * 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: #,0.00
		displayFolder: Price Index\Base
		lineageTag: bffbf157-719d-5e44-b65b-837a2b689e41

	measure 'PI Peso Index' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) ), 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) ), 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: f85f1c45-f16d-52c3-8d8f-d6fa8bf3962e

	/// Price Index del ETL (mediana de cocientes por PDV) ponderado por cruces de PDV. Exacto al grano de la tabla (par x semana x provincia x cliente); por encima de ese grano es una aproximación.
	measure 'PI Price Index' = DIVIDE ( [PI Suma Index], [PI Peso Index] )
		formatString: #,0.00
		displayFolder: Price Index\Base
		lineageTag: 61419f8a-60cc-597c-9351-78279119b62c

	measure 'PI Suma Index Comparable' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Price_Index] * 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Price_Index] * 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: #,0.00
		displayFolder: Price Index\Base
		lineageTag: 81c3d6aa-3acc-5a03-a10c-dda673df8b95

	measure 'PI Suma Nacional' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Price_Index_Nacional] * 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Price_Index_Nacional] * 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: #,0.00
		displayFolder: Price Index\Base
		lineageTag: ea9330ac-273d-5734-b1bf-ecc1453e03b9

	measure 'PI Peso Nacional' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( FILTER ( 'PRC Price_Index', NOT ISBLANK ( 'PRC Price_Index'[Price_Index] ) && NOT ISBLANK ( 'PRC Price_Index'[Price_Index_Nacional] ) ), 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: cf6e3da5-4918-5a02-806a-5542322cd16b

	/// Price Index Nacional (precio deflactado del numerador / denominador, fijo por par) ponderado por los mismos cruces que el Price Index, para que la comparación sea sobre el mismo mix de pares.
	measure 'PI Price Index Nacional' = DIVIDE ( [PI Suma Nacional], [PI Peso Nacional] )
		formatString: #,0.00
		displayFolder: Price Index\Base
		lineageTag: 697c2950-bd1a-55c3-89d5-195379210459

	/// Price Index menos Price Index Nacional, solo sobre los pares que tienen índice nacional.
	measure 'PI Brecha vs Nacional' = DIVIDE ( [PI Suma Index Comparable] - [PI Suma Nacional], [PI Peso Nacional] )
		formatString: +0.00;-0.00;0.00
		displayFolder: Price Index\Base
		lineageTag: 6c906ab4-c7bd-5fd3-a3dd-b8146abaef77

	measure 'PI Brecha vs Nacional %' = DIVIDE ( [PI Suma Index Comparable] - [PI Suma Nacional], [PI Suma Nacional] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Price Index\Base
		lineageTag: 81a8b931-bc17-59dc-aa0a-9c86d74471a4

	measure 'PI Pares' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    COUNTROWS ( SUMMARIZE ( 'PRC Price_Index', 'PRC Price_Index'[EAN_Numerador], 'PRC Price_Index'[EAN_Denominador] ) ),
			    CALCULATE ( COUNTROWS ( SUMMARIZE ( 'PRC Price_Index', 'PRC Price_Index'[EAN_Numerador], 'PRC Price_Index'[EAN_Denominador] ) ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: e0ba0dfd-f76b-5571-a7dc-dc4d0df5ed5a

	measure 'PI Provincias' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    DISTINCTCOUNT ( 'PRC Price_Index'[Provincia] ),
			    CALCULATE ( DISTINCTCOUNT ( 'PRC Price_Index'[Provincia] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: c2a38b18-7520-5f99-9ddd-f9f26c6b56e3

	/// PDV distintos al grano de la tabla. Por encima de ese grano es una suma: un mismo PDV se cuenta una vez por cada par y semana.
	measure 'PI PDV' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUM ( 'PRC Price_Index'[Cantidad_PDV] ),
			    CALCULATE ( SUM ( 'PRC Price_Index'[Cantidad_PDV] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		formatString: #,0
		displayFolder: Price Index\Base
		lineageTag: 03f670f2-ea3a-5fe8-a18f-139601051672

	measure 'PI Precio KG Num' = DIVIDE ( [PI Suma KG Num], [PI Cruces PDV] )
		formatString: \$ #,0.00
		displayFolder: Price Index\Base
		lineageTag: 725f71d4-ca33-5d54-aa37-4eedb385eab2

	measure 'PI Precio KG Den' = DIVIDE ( [PI Suma KG Den], [PI Cruces PDV] )
		formatString: \$ #,0.00
		displayFolder: Price Index\Base
		lineageTag: 97c4b9bb-882b-5b56-93e0-626d55f9f6c1

	measure 'PI Suma KG Num' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( 'PRC Price_Index', 'PRC Price_Index'[PDG_KG_Num] * 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( 'PRC Price_Index', 'PRC Price_Index'[PDG_KG_Num] * 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: \$ #,0
		displayFolder: Price Index\Base
		lineageTag: 90bbd399-d5d7-58c6-807a-e1030315de86

	measure 'PI Suma KG Den' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    SUMX ( 'PRC Price_Index', 'PRC Price_Index'[PDG_KG_Den] * 'PRC Price_Index'[Cantidad_Registros] ),
			    CALCULATE ( SUMX ( 'PRC Price_Index', 'PRC Price_Index'[PDG_KG_Den] * 'PRC Price_Index'[Cantidad_Registros] ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: \$ #,0
		displayFolder: Price Index\Base
		lineageTag: 2dadc428-e235-520d-b11d-80c203aaffe9

	measure 'PI Semana índice Ult' =
			IF (
			    HASONEVALUE ( Clientes[Nivel cliente] ),
			    CALCULATE ( MAX ( Calendario[Semana índice] ), 'PRC Price_Index' ),
			    CALCULATE ( CALCULATE ( MAX ( Calendario[Semana índice] ), 'PRC Price_Index' ), KEEPFILTERS ( Clientes[Nivel cliente] = "Subcanal" ) )
			)
		isHidden
		formatString: 0
		displayFolder: Price Index\Base
		lineageTag: 4fe7e6a5-783b-5583-907b-ad090571a24c

	measure 'PI Index Ult Sem' =
			VAR _sem = [PI Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PI Price Index], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: #,0.00
		displayFolder: Price Index\Índice
		lineageTag: cc19c064-0fd5-5c4c-9380-a916046d14bf

	measure 'PI Index Sem Ant' =
			VAR _sem = [PI Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PI Price Index], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem - 1 )
			    )
		formatString: #,0.00
		displayFolder: Price Index\Índice
		lineageTag: a0e3ee42-982d-54de-b701-77aa6904e479

	measure 'PI Var % Sem Ant' =
			VAR _ant = [PI Index Sem Ant]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( [PI Index Ult Sem] - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Price Index\Índice
		lineageTag: d14a71ba-e042-5a7f-9605-546d3ed41686

	measure 'PI Index 4 Sem Móvil' =
			VAR _sem = [PI Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE (
			            [PI Price Index],
			            REMOVEFILTERS ( Calendario ),
			            Calendario[Semana índice] > _sem - 4,
			            Calendario[Semana índice] <= _sem
			        )
			    )
		formatString: #,0.00
		displayFolder: Price Index\Índice
		lineageTag: ed8a9611-ca8b-5acc-aeb8-3e7294103edc

	/// Price Index de la fila menos el Price Index de toda la selección de los segmentadores.
	measure 'PI Desvío vs Total' =
			VAR _valor = [PI Price Index]
			RETURN
			    IF (
			        NOT ISBLANK ( _valor ),
			        _valor - CALCULATE ( [PI Price Index], ALLSELECTED ( Regiones ), ALLSELECTED ( Clientes ) )
			    )
		formatString: +0.00;-0.00;0.00
		displayFolder: Price Index\Índice
		lineageTag: 975a4dfc-3d89-510f-8a1c-85b0629018d5

	measure 'PI Nacional Ult Sem' =
			VAR _sem = [PI Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PI Price Index Nacional], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: #,0.00
		displayFolder: Price Index\Última semana
		lineageTag: e2a4cf1b-0266-58b3-be30-3886a25fa4ab

	measure 'PI Brecha Ult Sem' =
			VAR _sem = [PI Semana índice Ult]
			RETURN
			    IF (
			        NOT ISBLANK ( _sem ),
			        CALCULATE ( [PI Brecha vs Nacional], REMOVEFILTERS ( Calendario ), Calendario[Semana índice] = _sem )
			    )
		formatString: +0.00;-0.00;0.00
		displayFolder: Price Index\Última semana
		lineageTag: d9c7fccb-874c-5121-a5cd-f5b452ee1fba

