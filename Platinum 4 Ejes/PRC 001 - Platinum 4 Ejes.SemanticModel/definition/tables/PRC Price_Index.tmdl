	partition 'PRC Price_Index' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.1.82.27", "SANDBOX_BRONZE"),
				    PRC_platinum_4ejes = Origen{[Schema="PRC",Item="platinum_4ejes"]}[Data],
				    Filas = Table.SelectRows(PRC_platinum_4ejes, each [Tipo_Metrica] = "Price_Index"),
				    Columnas = Table.SelectColumns(Filas, {"Fecha", "Fuente", "Clave", "EAN_Numerador", "Desc_Numerador", "EAN_Denominador", "Desc_Denominador", "Region_v2", "Region_v2_Placeholder", "Provincia", "Subcanal", "Nivel_Cliente", "Cliente", "Price_Index", "Price_Index_Nacional", "PDG_KG_Num", "PDG_KG_Den", "Cantidad_PDV", "Cantidad_Registros"}),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"Fecha", type date}, {"Fuente", type text}, {"Clave", type text}, {"EAN_Numerador", type text}, {"Desc_Numerador", type text}, {"EAN_Denominador", type text}, {"Desc_Denominador", type text}, {"Region_v2", type text}, {"Region_v2_Placeholder", type logical}, {"Provincia", type text}, {"Subcanal", type text}, {"Nivel_Cliente", type text}, {"Cliente", type text}, {"Price_Index", type number}, {"Price_Index_Nacional", type number}, {"PDG_KG_Num", type number}, {"PDG_KG_Den", type number}, {"Cantidad_PDV", Int64.Type}, {"Cantidad_Registros", Int64.Type}}),
				    ClaveCliente = Table.AddColumn(Tipos, "Clave_Cliente", each [Nivel_Cliente] & "|" & [Subcanal] & "|" & [Cliente], type text),
				    Par = Table.AddColumn(ClaveCliente, "Par", each (if [Desc_Numerador] = null then [EAN_Numerador] else [Desc_Numerador]) & " vs " & (if [Desc_Denominador] = null then [EAN_Denominador] else [Desc_Denominador]), type text)
				in
				    Par

	annotation PBI_ResultType = Table

