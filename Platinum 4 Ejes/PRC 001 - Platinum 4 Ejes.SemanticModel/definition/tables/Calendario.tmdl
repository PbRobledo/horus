		annotation SummarizationSetBy = Automatic

	column 'Semana índice'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a20453fa-0bb0-5bde-9479-b77250449c40
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana índice]

		annotation SummarizationSetBy = Automatic

	column 'Semana filtro' =
			-- la última semana con relevamiento en cualquiera de los bloques se muestra como "Semana actual"
			VAR _max = MAX ( MAX ( 'PRC Precio_Simple'[Fecha] ), MAX ( 'PRC Price_Index'[Fecha] ) )
			VAR _ult = INT ( ( _max - WEEKDAY ( _max, 3 ) - DATE ( 2018, 1, 1 ) ) / 7 )
			RETURN
			    IF ( Calendario[Semana índice] = _ult, "Semana actual", Calendario[Semana] )
		dataType: string
		lineageTag: e08ab1c3-b758-5a46-baf7-9c54e03c6afd
		summarizeBy: none
		sortByColumn: 'Semana índice'

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				-- Calendario único: cubre de lunes a domingo las semanas con relevamiento en ambos bloques.
				-- La Fecha del ETL ya viene normalizada al lunes de la semana (Silver).
				VAR _minPS = MIN ( 'PRC Precio_Simple'[Fecha] )
				VAR _minPI = MIN ( 'PRC Price_Index'[Fecha] )
				VAR _min = IF ( ISBLANK ( _minPI ), _minPS, IF ( ISBLANK ( _minPS ), _minPI, MIN ( _minPS, _minPI ) ) )
				VAR _max = MAX ( MAX ( 'PRC Precio_Simple'[Fecha] ), MAX ( 'PRC Price_Index'[Fecha] ) )
				VAR _ini = _min - WEEKDAY ( _min, 3 )
				VAR _fin = _max - WEEKDAY ( _max, 3 ) + 6
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _ini, _fin ),
				        "Semana inicio", [Date] - WEEKDAY ( [Date], 3 ),
				        "Año", YEAR ( [Date] - WEEKDAY ( [Date], 3 ) ),
				        "Mes Nro", MONTH ( [Date] - WEEKDAY ( [Date], 3 ) ),
				        "Mes", FORMAT ( [Date] - WEEKDAY ( [Date], 3 ), "mmmm" ),
				        "Año ISO", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				        "Semana ISO", WEEKNUM ( [Date], 21 ),
				        "Semana", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ) & "-S" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				        "Semana índice", INT ( ( [Date] - WEEKDAY ( [Date], 3 ) - DATE ( 2018, 1, 1 ) ) / 7 )
				    )

	annotation PBI_Id = 9f41ca57e0aa51bdbc345c5ff8a023fa

