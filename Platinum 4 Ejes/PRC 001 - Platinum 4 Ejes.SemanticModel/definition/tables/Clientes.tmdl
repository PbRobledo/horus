		isNameInferred
		sourceColumn: [Fuente]

		annotation SummarizationSetBy = Automatic

	partition Clientes = calculated
		mode: import
		source =
				-- Eje Cliente, compartido por los dos bloques (Precio Simple y Price Index).
				-- Una fila por Nivel + Subcanal + Cliente. Nivel "Subcanal" = panel COPI (Cliente = "(Todos)");
				-- nivel "Cliente" = cadena de Canal Moderno, panel SNP. Son dos relevamientos independientes:
				-- las medidas nunca los suman entre sí (ver _Medidas).
				VAR _ps =
				    SELECTCOLUMNS (
				        'PRC Precio_Simple',
				        "Clave cliente", 'PRC Precio_Simple'[Clave_Cliente],
				        "Nivel cliente", 'PRC Precio_Simple'[Nivel_Cliente],
				        "Subcanal", 'PRC Precio_Simple'[Subcanal],
				        "Cliente", 'PRC Precio_Simple'[Cliente],
				        "Fuente", 'PRC Precio_Simple'[Fuente]
				    )
				VAR _pi =
				    SELECTCOLUMNS (
				        'PRC Price_Index',
				        "Clave cliente", 'PRC Price_Index'[Clave_Cliente],
				        "Nivel cliente", 'PRC Price_Index'[Nivel_Cliente],
				        "Subcanal", 'PRC Price_Index'[Subcanal],
				        "Cliente", 'PRC Price_Index'[Cliente],
				        "Fuente", 'PRC Price_Index'[Fuente]
				    )
				RETURN
				    FILTER ( DISTINCT ( UNION ( _ps, _pi ) ), NOT ISBLANK ( [Clave cliente] ) )

	annotation PBI_Id = 07908d52cf1751b9bdf21771bad6cf55

