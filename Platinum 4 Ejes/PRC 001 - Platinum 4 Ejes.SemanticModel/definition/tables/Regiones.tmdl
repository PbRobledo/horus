table Regiones
	lineageTag: 74d120c7-f693-5011-9f1c-36ea6d13b7d1

	column 'Región v2'
		dataType: string
		lineageTag: ab008d4e-7894-560b-9d8c-99ee6ad840d3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Región v2]

		annotation SummarizationSetBy = Automatic

	column Provincia
		dataType: string
		lineageTag: aaa71809-d276-50e1-a810-78ba1ad7a771
		summarizeBy: none
		isNameInferred
		sourceColumn: [Provincia]

		annotation SummarizationSetBy = Automatic

	partition Regiones = calculated
		mode: import
		source =
				-- Eje Geográfico, compartido por los dos bloques. Hoy Región v2 = Provincia (placeholder del ETL,
				-- Region_v2_Placeholder = 1). Cuando el maestro tenga la región real, esta tabla la toma sola:
				-- la clave es Región v2 y Provincia queda como nivel superior.
				VAR _ps =
				    SELECTCOLUMNS (
				        'PRC Precio_Simple',
				        "Región v2", 'PRC Precio_Simple'[Region_v2],
				        "Provincia", 'PRC Precio_Simple'[Provincia]
				    )
				VAR _pi =
				    SELECTCOLUMNS (
				        'PRC Price_Index',
				        "Región v2", 'PRC Price_Index'[Region_v2],
				        "Provincia", 'PRC Price_Index'[Provincia]
				    )
				RETURN
				    FILTER ( DISTINCT ( UNION ( _ps, _pi ) ), NOT ISBLANK ( [Región v2] ) )

	annotation PBI_Id = 1deb40a4e54c574da629a727d059258a

